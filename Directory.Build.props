<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<AnalysisLevel>latest</AnalysisLevel>
		<!-- Copyright is deliberately UNGATED, unlike the package metadata in
		     Directory.Build.targets: every assembly shipped in the Docker image and the release
		     zips must carry an AssemblyCopyright attribute, not just the two packable projects.
		     The repository is licensed in two parts (MIT for the plugin contract, PolyForm
		     Noncommercial for the gateway) — see LICENSE. -->
		<Copyright>Copyright (c) 2026 Ruben Andersen</Copyright>
	</PropertyGroup>

	<!-- THE backend plugin contract version — one definition for both ActiveSync.Contracts and
	     ActiveSync.Protocol, which version together as a single surface.

	     DELIBERATELY INDEPENDENT of the gateway release version. The release tag arrives as a
	     global -p:Version and must never reach those two projects: if it did, tagging the gateway
	     2.0.0 for a product reason would flip the contract major and lock out every existing
	     plugin without the contract having changed at all.

	     Raise Major or Minor ONLY when the surface of either project changes. BOTH count as
	     breaking — the loader demands an exact major.minor match — so Minor absorbs breaks that
	     would otherwise inflate Major into a meaningless counter. Patch is free: use it for
	     non-surface fixes (docs, comments), and the loader ignores it. -->
	<PropertyGroup>
		<ContractVersionMajor>1</ContractVersionMajor>
		<ContractVersionMinor>2</ContractVersionMinor>
		<ContractVersionPatch>0</ContractVersionPatch>
		<ContractVersion>$(ContractVersionMajor).$(ContractVersionMinor).$(ContractVersionPatch)</ContractVersion>
	</PropertyGroup>

	<!-- NuGet: nothing packs unless a project opts in with <IsPackable>true</IsPackable>.
	     Exactly two do — ActiveSync.Contracts (the plugin contract) and ActiveSync.Protocol
	     (its single dependency); see the CI pack/push step. The package METADATA (authors,
	     license, repository URLs, symbols) lives in Directory.Build.targets gated on
	     IsPackable, so a host-only assembly carries no packaging identity at all. -->
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<!-- `dotnet pack ActiveSync.slnx` intentionally skips the app/test/backend projects;
		     don't warn about each one — IsPackable is the deliberate allow-list. -->
		<WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
		<!-- Deterministic builds on CI (Continuous Integration Build). -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsPackable)' == 'true'">
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
	</ItemGroup>

	<!-- Docker builds (image + the in-image NuGet pack) have no .git — .dockerignore excludes
	     it — so the SourceLink git tasks warned twice per packable project ("unable to locate
	     repository" / "source link is empty") and produced an empty source link anyway. Turn
	     the queries off explicitly when the repo folder is absent: same output, no warnings.
	     Repository package metadata is unaffected (RepositoryUrl above is static), and builds
	     from a real checkout (IDE, local dotnet) keep full SourceLink. -->
	<PropertyGroup Condition="!Exists('$(MSBuildThisFileDirectory).git')">
		<EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
		<EnableSourceLink>false</EnableSourceLink>
	</PropertyGroup>
</Project>
