<Project Sdk="Microsoft.NET.Sdk.Web">

	<!-- Precompile to native on RID-targeted publishes (Docker image + download zips): faster
	     `serve` startup and a faster in-container `eas` fallback. Ignored on plain builds. -->
	<PropertyGroup>
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
		<PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Serilog.Enrichers.Environment" />
		<PackageReference Include="Serilog.Enrichers.Thread" />
		<PackageReference Include="Serilog.Formatting.Compact" />
		<PackageReference Include="Spectre.Console" />
		<PackageReference Include="Spectre.Console.Cli" />
		<!-- Startup project for `dotnet ef` migration commands. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- Explicit even though every backend/WebUi reference below already pulls it in transitively —
		     Server depends on Core pervasively (CliServices, BackendProviderRegistry, ...) and this makes
		     that dependency honest instead of an accident of the other references (S1). -->
		<ProjectReference Include="..\ActiveSync.Core\ActiveSync.Core.csproj" />
		<!-- The format -> EAS-XML conversion layer. Server is its only consumer: under the typed
		     item currency every conversion happens above the store boundary, in Eas/Content. -->
		<ProjectReference Include="..\ActiveSync.Eas.Conversion\ActiveSync.Eas.Conversion.csproj" />
		<ProjectReference Include="..\ActiveSync.Backends.Common\ActiveSync.Backends.Common.csproj" />
		<ProjectReference Include="..\ActiveSync.Backends.Imap\ActiveSync.Backends.Imap.csproj" />
		<ProjectReference Include="..\ActiveSync.Backends.Jmap\ActiveSync.Backends.Jmap.csproj" />
		<ProjectReference Include="..\ActiveSync.Backends.Smtp\ActiveSync.Backends.Smtp.csproj" />
		<ProjectReference Include="..\ActiveSync.Backends.Dav\ActiveSync.Backends.Dav.csproj" />
		<ProjectReference Include="..\ActiveSync.Backends.Sieve\ActiveSync.Backends.Sieve.csproj" />
		<ProjectReference Include="..\ActiveSync.Backends.Local\ActiveSync.Backends.Local.csproj" />
		<ProjectReference Include="..\ActiveSync.WebUi\ActiveSync.WebUi.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ActiveSync.Server.Tests" />
	</ItemGroup>

</Project>
