<Project Sdk="Microsoft.NET.Sdk">

	<!-- Shared backend building blocks: the MIME/iCalendar/vCard <-> EAS converters plus the
	     TLS/wire-logging helpers every network provider reuses. Carries the heavy converter
	     package dependencies so Core stays free of them. In-repo only, NOT published (packed
	     until 1.1.2) — a plugin brings its own converters. -->

	<ItemGroup>
		<ProjectReference Include="..\ActiveSync.Contracts\ActiveSync.Contracts.csproj" />
		<!-- EXPLICIT since the contract severed its own Protocol reference: the EAS namespaces,
		     the compact date format and the wire-log payload cap are used directly here (this is
		     Protocol's heaviest consumer), and they no longer arrive transitively via Contracts. -->
		<ProjectReference Include="..\ActiveSync.Protocol\ActiveSync.Protocol.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Lets Core.Tests exercise TimeZoneBlob.WriteName directly with a real surrogate
		     pair, which TimeZoneInfo.CreateCustomTimeZone itself sanitizes away before it ever
		     reaches the field-write code — same grant pattern the Imap/Smtp/Jmap/Dav csprojs use. -->
		<InternalsVisibleTo Include="ActiveSync.Core.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FolkerKinzel.VCards" />
		<PackageReference Include="Ical.Net" />
		<PackageReference Include="MailKit" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

</Project>
