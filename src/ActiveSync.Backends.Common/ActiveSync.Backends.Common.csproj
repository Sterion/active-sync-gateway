<Project Sdk="Microsoft.NET.Sdk">

	<!-- Shared backend building blocks: the TLS/wire-logging and HTTP helpers every network
	     provider reuses, the shared backend-options bases and config schema fields, and the
	     payload helpers a STORE needs for its own data (UID extraction, PARTSTAT, inline
	     attachments, free/busy, mail keyword classification). It keeps Ical.Net and
	     FolkerKinzel.VCards for those; the EAS half of the old converters is host-side, in
	     ActiveSync.Eas.Conversion. In-repo only, NOT published (packed until 1.1.2). -->

	<ItemGroup>
		<ProjectReference Include="..\ActiveSync.Contracts\ActiveSync.Contracts.csproj" />
		<!-- EXPLICIT since the contract severed its own Protocol reference. Now a single call
		     deep: an iCalendar UTC date-time is byte-identical to the EAS compact form, so the
		     free-busy parser still reads them with EasDateTime. -->
		<ProjectReference Include="..\ActiveSync.Protocol\ActiveSync.Protocol.csproj" />
		<!-- The iCalendar load/serialize quirk handling, shared with the host's conversion layer. -->
		<ProjectReference Include="..\ActiveSync.Contracts.Interop\ActiveSync.Contracts.Interop.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FolkerKinzel.VCards" />
		<PackageReference Include="Ical.Net" />
		<PackageReference Include="MailKit" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

</Project>
