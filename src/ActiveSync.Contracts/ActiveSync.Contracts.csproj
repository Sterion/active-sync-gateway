<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  The plugin contract: the interfaces, records and small helpers an out-of-repo backend
	  plugin builds against (IBackendProvider, IContentStore, IGatewayPlugin, BackendRole,
	  ProviderSettings, BackendConfigField, ...). Deliberately tiny — it references only
	  ActiveSync.Protocol (EAS constants) and the Microsoft.Extensions config/DI abstractions,
	  NOT Crypto, EF Core or Core's host graph. A plugin references THIS one package alone —
	  Core, Crypto and Backends.Common are host-only and are no longer published.
	  Licensed MIT (see LICENSE-MIT) so third-party plugins, including commercial ones, can
	  build against it freely; the rest of the repository is PolyForm Noncommercial.
	-->
	<PropertyGroup>
		<RootNamespace>ActiveSync.Contracts</RootNamespace>
	</PropertyGroup>

	<!-- Versioned by the CONTRACT, not by the gateway release. These are set explicitly so the
	     global -p:Version=<tag> CI passes for the release build cannot reach them: the SDK only
	     falls back to $(Version) for a version property the project leaves empty. See the
	     ContractVersion block in Directory.Build.props for why that separation is load-bearing. -->
	<PropertyGroup>
		<AssemblyVersion>$(ContractVersion).0</AssemblyVersion>
		<FileVersion>$(ContractVersion).0</FileVersion>
		<PackageVersion>$(ContractVersion)</PackageVersion>
		<InformationalVersion>$(ContractVersion)</InformationalVersion>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>ActiveSync.Contracts</PackageId>
		<Description>ActiveSync Gateway — the backend plugin contract (IBackendProvider, IContentStore, IGatewayPlugin, roles, provider settings and config schema). The one package to reference when writing a gateway backend plugin.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ActiveSync.Protocol\ActiveSync.Protocol.csproj" />
	</ItemGroup>

	<!-- Lets ContractVersionTests exercise the internal ResolveAssemblyVersion fallback
	     directly (with a null input) — the real assembly always has a version in a normal build,
	     so there is no other way to observe that fallback deterministically. -->
	<ItemGroup>
		<InternalsVisibleTo Include="ActiveSync.Core.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	</ItemGroup>

</Project>
