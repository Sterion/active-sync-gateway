<Project Sdk="Microsoft.NET.Sdk">

	<!-- Published so out-of-repo plugins compile against the EAS/WBXML contract. Licensed MIT
	     (see LICENSE-MIT) — one of only two projects that are; the rest of the repository is
	     PolyForm Noncommercial. Anything moved INTO this assembly becomes permanently
	     permissive, so keep it to protocol primitives. -->
	<!-- Versioned by the CONTRACT alongside ActiveSync.Contracts, not by the gateway release —
	     set explicitly so a global -p:Version=<tag> cannot reach them. See Directory.Build.props. -->
	<PropertyGroup>
		<AssemblyVersion>$(ContractVersion).0</AssemblyVersion>
		<FileVersion>$(ContractVersion).0</FileVersion>
		<PackageVersion>$(ContractVersion)</PackageVersion>
		<InformationalVersion>$(ContractVersion)</InformationalVersion>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<!-- Ship the XML docs — see the matching comment in ActiveSync.Contracts.csproj for why
		     this cannot live with the other package-scoped properties in Directory.Build.targets.
		     CS1591/CS1573 are live here against a 0-warning baseline: a new undocumented public
		     member FAILS the build. Document it; never suppress it. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>ActiveSync.Protocol</PackageId>
		<Description>ActiveSync Gateway — EAS/WBXML protocol primitives (code pages, constants, query parser). Reference this to build a gateway backend plugin.</Description>
	</PropertyGroup>

</Project>
