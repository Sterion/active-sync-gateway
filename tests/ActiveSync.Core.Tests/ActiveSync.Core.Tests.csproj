<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ActiveSync.Core\ActiveSync.Core.csproj" />
		<!-- The converter unit tests live here (there is no per-assembly test project), so the
		     EAS-conversion assembly and the interop helpers are referenced directly. -->
		<ProjectReference Include="..\..\src\ActiveSync.Eas.Conversion\ActiveSync.Eas.Conversion.csproj" />
		<ProjectReference Include="..\..\src\ActiveSync.Contracts.Interop\ActiveSync.Contracts.Interop.csproj" />
		<!-- The published conformance kit, run against the fixture plugin's store — the in-repo proof
		     that a plugin built on ActiveSync.Contracts alone satisfies the store obligations, and
		     that the kit itself works. -->
		<ProjectReference Include="..\..\src\ActiveSync.Contracts.Conformance\ActiveSync.Contracts.Conformance.csproj" />
		<ProjectReference Include="..\..\src\ActiveSync.Backends.Imap\ActiveSync.Backends.Imap.csproj" />
		<ProjectReference Include="..\..\src\ActiveSync.Backends.Jmap\ActiveSync.Backends.Jmap.csproj" />
		<ProjectReference Include="..\..\src\ActiveSync.Backends.Smtp\ActiveSync.Backends.Smtp.csproj" />
		<ProjectReference Include="..\..\src\ActiveSync.Backends.Dav\ActiveSync.Backends.Dav.csproj" />
		<ProjectReference Include="..\..\src\ActiveSync.Backends.Sieve\ActiveSync.Backends.Sieve.csproj" />
		<ProjectReference Include="..\..\src\ActiveSync.Backends.Local\ActiveSync.Backends.Local.csproj" />
		<!-- Built (not referenced) so PluginLoaderTests can load it from a plugins dir at
		     runtime; the AfterBuild target below stages its DLL under testplugin/. -->
		<ProjectReference Include="..\ActiveSync.TestPlugin\ActiveSync.TestPlugin.csproj"
		                  ReferenceOutputAssembly="false" />
		<!-- Likewise for the filesystem plugin, which LocalFilesPluginConformanceTests loads through
		     the real loader and runs the conformance kit against. -->
		<ProjectReference Include="..\ActiveSync.Plugin.Local\ActiveSync.Plugin.Local.csproj"
		                  ReferenceOutputAssembly="false" />
		<!-- Referenced NORMALLY, unlike the plugin itself: the host must have its own copy loadable
		     from the default context, so PluginLoaderTests can prove the plugin binds to the copy
		     in its own folder instead (K41). -->
		<ProjectReference Include="..\PluginPrivateLib\PluginPrivateLib.csproj" />
	</ItemGroup>

	<!-- Stage the fixture plugin's assembly in a subfolder of the test output (NOT the base
	     dir — it must not be probed by the default load context) so PluginLoaderTests can copy
	     it into a temp plugins directory and load it fresh. -->
	<Target Name="StageTestPlugin" AfterTargets="Build">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\ActiveSync.TestPlugin\bin\$(Configuration)\$(TargetFramework)\ActiveSync.TestPlugin.dll;$(MSBuildThisFileDirectory)..\ActiveSync.TestPlugin\bin\$(Configuration)\$(TargetFramework)\PluginPrivateLib.dll"
		      DestinationFolder="$(OutDir)testplugin" SkipUnchangedFiles="true" />
	</Target>

	<!-- Only the ENTRY assembly is staged: Microsoft.Extensions.Logging.Abstractions must resolve
	     from the host (the loader shares Microsoft.Extensions.* by design), and the loader checks
	     every DLL beneath a plugin directory against the host's contract version. -->
	<Target Name="StageLocalFilesPlugin" AfterTargets="Build">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\ActiveSync.Plugin.Local\bin\$(Configuration)\$(TargetFramework)\ActiveSync.Plugin.Local.dll"
		      DestinationFolder="$(OutDir)localfilesplugin" SkipUnchangedFiles="true" />
	</Target>

</Project>
