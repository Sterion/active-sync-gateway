<Project Sdk="Microsoft.NET.Sdk">

	<!-- An out-of-repo-style plugin with a REAL store (TestNotesStore), compiled so PluginLoaderTests
	     can load it from a temp plugins directory and so the conformance kit has something genuine
	     to validate. Of the gateway's assemblies it references ActiveSync.Contracts ONLY — the
	     published plugin contract — proving a backend plugin needs nothing else (no Core, Crypto,
	     EF Core, and no MIME/iCalendar/vCard library, which is what makes Notes the right class to
	     prove it with). PluginPrivateLib below is not a gateway assembly: it stands in for a
	     plugin's own private dependency. Not packable and not a test project itself. -->
	<PropertyGroup>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ActiveSync.Contracts\ActiveSync.Contracts.csproj" />
		<!-- Stands in for a plugin's private dependency; see that project's own comment. -->
		<ProjectReference Include="..\PluginPrivateLib\PluginPrivateLib.csproj" />
	</ItemGroup>

	<!-- Every plugin entry assembly must declare the contract it supports. An out-of-repo plugin
	     writes `[assembly: SupportedGatewayContract(1, 0)]` in source; this in-repo fixture takes
	     the value from the same property the host is built from, so it can never go stale when the
	     contract version is raised. -->
	<ItemGroup>
		<AssemblyAttribute Include="ActiveSync.Contracts.SupportedGatewayContractAttribute">
			<_Parameter1>$(ContractVersionMajor)</_Parameter1>
			<_Parameter1_TypeName>System.Int32</_Parameter1_TypeName>
			<_Parameter2>$(ContractVersionMinor)</_Parameter2>
			<_Parameter2_TypeName>System.Int32</_Parameter2_TypeName>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
